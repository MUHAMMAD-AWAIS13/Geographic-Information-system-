var CONFIG = {
  driveFolder: 'Faisalabad_Atlas',
  crs: 'EPSG:32643',              // UTM zone 43N, metres, for exported analysis layers

  censusYear: 2023,               // WorldPop R2025A year used to distribute the census counts
  smodYear: 2020,                 // GHS-SMOD epoch. 2020 is the latest non-projected epoch
  builtYear: 2020,                // GHS-BUILT-S epoch. Same reason

  builtMinFraction: 0.10,         // a 100 m cell counts as built-up at 10% built surface or more
  settlementMinHa: 5,             // smaller built-up patches are dropped
  settlementBreaks: [2000, 10000, 50000],  // analytical size classes, not legal status

  areaReviewPct: 10,              // GIS vs census area difference above this is marked REVIEW
  constrainTolPct: 1,             // fitted grid must match the census within this per tehsil
  tileScale: 4,                   // raise to 8 or 16 if a computation runs out of memory

  // Optional: official tehsil polygons. Names must match tehsilCensus exactly.
  tehsilAsset: '',
  tehsilNameField: '',

  // Optional: Union Council polygons.
  // Example: 'projects/your-project/assets/faisalabad_uc'
  ucAsset: '',
  ucNameField: '',
  ucCodeField: '',

  // Optional: UC census table, joined to the polygons on the code field.
  ucCensusAsset: '',
  ucCensusCodeField: '',
  ucCensusPopField: '',

  // Optional: named settlement points.
  settlementAsset: '',
  settlementNameField: ''
};

// Official district totals, used only as controls.
var OFFICIAL = {
  population: 9075819,
  urban: 4392979,
  rural: 4682840,
  areaKm2: 5857
};

var TEHSIL_COUNT = 6;

// Colour-vision-safe palettes.
var PAL = {
  tehsilDensity: ['ffffcc', 'a1dab4', '41b6c4', '225ea8'],
  grid: ['f7fcf0', 'ccebc5', '7bccc4', '2b8cbe', '084081'],
  urbanCentre: 'D55E00',
  urbanCluster: 'E69F00',
  rural: '009E73',
  water: '56B4E9',
  built: '000000',
  metro: 'CC79A7',
  uc: '6a3d9a'
};

var DENSITY_BREAKS = [750, 1000, 2000];
var DENSITY_LABELS = ['Below 750', '750 to 1,000', '1,000 to 2,000', 'Above 2,000'];

// ----------------------------- BOUNDARIES ------------------------------
var census = tehsilCensus();
var censusLookup = {};
census.forEach(function (row) { censusLookup[row.tehsil] = row; });
var tehsilNames = census.map(function (row) { return row.tehsil; });

var tehsilGeoms;
if (CONFIG.tehsilAsset) {
  tehsilGeoms = ee.FeatureCollection(CONFIG.tehsilAsset)
    .filter(ee.Filter.inList(CONFIG.tehsilNameField, tehsilNames))
    .map(function (f) {
      return ee.Feature(f.geometry(), {tehsil: f.get(CONFIG.tehsilNameField)});
    });
} else {
  var embedded = tehsilGeometry();
  tehsilGeoms = ee.FeatureCollection(tehsilNames.map(function (name) {
    return ee.Feature(ee.Geometry.Polygon(embedded[name], 'EPSG:4326', false), {tehsil: name});
  }));
}

var censusDict = ee.Dictionary(censusLookup);

var tehsilBase = tehsilGeoms.map(function (f) {
  var row = ee.Dictionary(censusDict.get(f.get('tehsil')));
  var gisKm2 = f.geometry().area(1).divide(1e6);
  var pop = ee.Number(row.get('pop2023'));
  var censusKm2 = ee.Number(row.get('census_area_km2'));
  return f.set(row).set({
    gis_area_km2: gisKm2,
    area_diff_pct: gisKm2.subtract(censusKm2).divide(censusKm2).multiply(100),
    density_census: pop.divide(censusKm2),
    density_gis: pop.divide(gisKm2)
  });
});

var districtGeom = tehsilGeoms.union(1).geometry();
var districtFc = ee.FeatureCollection([ee.Feature(districtGeom, {
  district: 'Faisalabad',
  pop2023: OFFICIAL.population,
  pop2023_urban: OFFICIAL.urban,
  pop2023_rural: OFFICIAL.rural,
  census_area_km2: OFFICIAL.areaKm2,
  gis_area_km2: districtGeom.area(1).divide(1e6),
  density_census: OFFICIAL.population / OFFICIAL.areaKm2
})]);

// ------------------------------ POPULATION -----------------------------
var wpCollection = ee.ImageCollection('WorldPop/GP/100m/R2025A/v1/pop')
  .filter(ee.Filter.eq('year', CONFIG.censusYear))
  .filter(ee.Filter.eq('country', 'PAK'));
var worldpop = ee.Image(wpCollection.first()).select('population');

// Counts must be summed on the native grid. Any other grid would change the totals.
var popProj = worldpop.projection();
var popScale = popProj.nominalScale();

function sumOnPopGrid(image, collection) {
  return image.reduceRegions({
    collection: collection,
    reducer: ee.Reducer.sum(),
    crs: popProj,
    scale: popScale,
    tileScale: CONFIG.tileScale
  });
}

// Scale each tehsil's modelled pixels so they sum to its census count.
var tehsilFit = sumOnPopGrid(worldpop, tehsilBase).map(function (f) {
  var modelled = ee.Number(f.get('sum'));
  return f.set({
    pop_worldpop: modelled,
    fit_factor: ee.Number(f.get('pop2023')).divide(modelled)
  });
});

var fitFactor = tehsilFit.reduceToImage(['fit_factor'], ee.Reducer.first()).rename('fit_factor');
var popFitted = worldpop.multiply(fitFactor).rename('pop_fitted').setDefaultProjection(popProj);
// Fixed to the native grid: otherwise, when zoomed out, mean counts get divided by a large pixel's area.
var pixelKm2 = ee.Image.pixelArea().divide(1e6).reproject(popProj);
var popDensity = popFitted.divide(pixelKm2).rename('pop_per_km2');

// --------------------------- URBAN/RURAL CLASSES -----------------------
var smod = ee.Image('JRC/GHSL/P2023A/GHS_SMOD_V2-0/' + CONFIG.smodYear).select('smod_code');
// 1 urban centre, 2 urban cluster, 3 rural, 4 water
var urbanClass = smod.remap([30, 23, 22, 21, 13, 12, 11, 10], [1, 2, 2, 2, 3, 3, 3, 4])
  .rename('urban_class');

var classImage = ee.Image.cat([
  popFitted.rename('pop_fit_total'),
  popFitted.updateMask(urbanClass.eq(1)).rename('pop_urban_centre'),
  popFitted.updateMask(urbanClass.eq(2)).rename('pop_urban_cluster'),
  popFitted.updateMask(urbanClass.eq(3)).rename('pop_rural'),
  pixelKm2.updateMask(urbanClass.eq(1)).rename('km2_urban_centre'),
  pixelKm2.updateMask(urbanClass.eq(2)).rename('km2_urban_cluster'),
  pixelKm2.updateMask(urbanClass.eq(3)).rename('km2_rural')
]);

var tehsilStats = sumOnPopGrid(classImage, tehsilFit).map(function (f) {
  var total = ee.Number(f.get('pop_fit_total'));
  var urban = ee.Number(f.get('pop_urban_centre')).add(f.get('pop_urban_cluster'));
  return f.set({
    pop_urban_model: urban,
    pop_rural_model: f.get('pop_rural'),
    urban_share_model_pct: urban.divide(total).multiply(100),
    fit_error_pct: total.subtract(f.get('pop2023')).divide(f.get('pop2023')).multiply(100).abs()
  });
});

var densityClass = tehsilStats.reduceToImage(['density_census'], ee.Reducer.first());
var densityClassImage = densityClass.gte(DENSITY_BREAKS[0])
  .add(densityClass.gte(DENSITY_BREAKS[1]))
  .add(densityClass.gte(DENSITY_BREAKS[2]));

// ------------------------- METROPOLITAN EXTENT -------------------------
// Urban-centre patches touching the Faisalabad City tehsil, cut at the district edge.
var cityTehsil = tehsilGeoms.filter(ee.Filter.eq('tehsil', 'Faisalabad City'));
var metroRaw = urbanClass.eq(1).selfMask().reduceToVectors({
  geometry: districtGeom,
  crs: smod.projection(),
  scale: 1000,
  geometryType: 'polygon',
  eightConnected: true,
  maxPixels: 1e9,
  tileScale: CONFIG.tileScale
}).filterBounds(cityTehsil);

var metro = sumOnPopGrid(popFitted, metroRaw).map(function (f) {
  return ee.Feature(f.geometry(), {
    name: 'Faisalabad urban centre (GHS-SMOD ' + CONFIG.smodYear + ')',
    area_km2: f.geometry().area(100).divide(1e6),
    pop_fitted: f.get('sum')
  });
});

// ------------------------ SETTLEMENTS (BUILT-UP) -----------------------
var built = ee.Image('JRC/GHSL/P2023A/GHS_BUILT_S/' + CONFIG.builtYear).select('built_surface');
var builtProj = built.projection();
var builtMask = built.gte(CONFIG.builtMinFraction * 10000).rename('built');

var patchesRaw = builtMask.selfMask().reduceToVectors({
  geometry: districtGeom,
  crs: builtProj,
  scale: 100,
  geometryType: 'polygon',
  eightConnected: true,
  maxPixels: 1e9,
  tileScale: CONFIG.tileScale
}).map(function (f) {
  return f.set('area_ha', f.geometry().area(10).divide(1e4));
}).filter(ee.Filter.gte('area_ha', CONFIG.settlementMinHa));

var patchesPop = sumOnPopGrid(popFitted, patchesRaw);
var patchesClass = urbanClass.reduceRegions({
  collection: patchesPop,
  reducer: ee.Reducer.mode(),
  crs: builtProj,
  scale: 100,
  tileScale: CONFIG.tileScale
});

var b = CONFIG.settlementBreaks;
function sizeClass(pop) {
  return ee.Algorithms.If(pop.lt(b[0]), 'Small village, below ' + b[0],
    ee.Algorithms.If(pop.lt(b[1]), 'Village, ' + b[0] + ' to ' + b[1],
      ee.Algorithms.If(pop.lt(b[2]), 'Town, ' + b[1] + ' to ' + b[2],
        'City or conurbation, ' + b[2] + ' and above')));
}

var urbanNames = ee.Dictionary({'1': 'Urban centre', '2': 'Urban cluster', '3': 'Rural', '4': 'Water'});

var settlements = patchesClass.map(function (f) {
  var pop = ee.Number(f.get('sum'));
  var mode = f.get('mode');
  return ee.Feature(f.geometry(), {
    settlement_id: f.get('system:index'),
    area_ha: f.get('area_ha'),
    pop_fitted: pop,
    size_class: sizeClass(pop),
    urban_class: ee.Algorithms.If(mode,
      urbanNames.get(ee.Number(mode).int().format('%d')), 'Unclassified')
  });
});

var settlementPointsRaw = settlements.map(function (f) {
  return f.setGeometry(f.geometry().centroid(10));
});

// Points carry the tehsil they fall in. outer:true keeps a point that lands on no tehsil.
var settlementPoints = ee.Join.saveFirst({matchKey: 'tehsil_match', outer: true})
  .apply(settlementPointsRaw, tehsilGeoms, ee.Filter.intersects({
    leftField: '.geo', rightField: '.geo', maxError: 10
  }))
  .map(function (f) {
    var match = f.get('tehsil_match');
    return ee.Feature(f.geometry(), f.toDictionary(
      ['settlement_id', 'area_ha', 'pop_fitted', 'size_class', 'urban_class']
    )).set('tehsil', ee.Algorithms.If(match, ee.Feature(match).get('tehsil'), 'Outside tehsils'));
  });

var namedSettlements = null;
if (CONFIG.settlementAsset) {
  namedSettlements = ee.FeatureCollection(CONFIG.settlementAsset)
    .filterBounds(districtGeom)
    .map(function (f) {
      return ee.Feature(f.geometry(), {name: f.get(CONFIG.settlementNameField)});
    });
}

// ---------------------------- UNION COUNCILS ---------------------------
var ucStats = null;
var ucCensusMatched = null;
if (CONFIG.ucAsset) {
  // A UC belongs to the district if its centroid does. filterBounds alone would admit neighbours.
  var ucInside = ee.FeatureCollection(CONFIG.ucAsset)
    .filterBounds(districtGeom)
    .map(function (f) {
      return f.set('in_district', districtGeom.contains(f.geometry().centroid(10), 10));
    })
    .filter(ee.Filter.eq('in_district', true))
    .map(function (f) {
      return ee.Feature(f.geometry(), {
        uc_name: f.get(CONFIG.ucNameField),
        uc_code: ee.Algorithms.String(f.get(CONFIG.ucCodeField)),
        area_km2: f.geometry().area(1).divide(1e6)
      });
    });

  var ucJoined = ucInside;
  if (CONFIG.ucCensusAsset) {
    var ucCensus = ee.FeatureCollection(CONFIG.ucCensusAsset).map(function (f) {
      return ee.Feature(null, {
        uc_code: ee.Algorithms.String(f.get(CONFIG.ucCensusCodeField)),
        pop2023_census: f.get(CONFIG.ucCensusPopField)
      });
    });
    ucJoined = ee.Join.saveFirst({matchKey: 'census_match', outer: true})
      .apply(ucInside, ucCensus, ee.Filter.equals({leftField: 'uc_code', rightField: 'uc_code'}))
      .map(function (f) {
        var match = f.get('census_match');
        return ee.Feature(f.geometry(), f.toDictionary(['uc_name', 'uc_code', 'area_km2']))
          .set('pop2023_census', ee.Algorithms.If(match, ee.Feature(match).get('pop2023_census'), -1));
      });
    ucCensusMatched = ucJoined.filter(ee.Filter.gte('pop2023_census', 0)).size();
  }

  ucStats = sumOnPopGrid(classImage, ucJoined).map(function (f) {
    var total = ee.Number(f.get('pop_fit_total'));
    return f.set({
      density_fitted: total.divide(f.get('area_km2')),
      urban_share_model_pct: ee.Number(f.get('pop_urban_centre')).add(f.get('pop_urban_cluster'))
        .divide(total.max(1)).multiply(100)
    });
  });
}

// ------------------------------- CONTROLS ------------------------------
function control(id, description, observed, expected, status, note) {
  return ee.Feature(null, {
    id: id, description: description, observed: observed,
    expected: expected, status: status, note: note
  });
}
function clientStatus(ok) { return ok ? 'PASS' : 'FAIL'; }

var censusSum = census.reduce(function (s, r) { return s + r.pop2023; }, 0);
var areaSum = census.reduce(function (s, r) { return s + r.census_area_km2; }, 0);
var modelledTotal = tehsilFit.aggregate_sum('pop_worldpop');
var tehsilAreaSum = tehsilBase.aggregate_sum('gis_area_km2');
var dissolvedArea = districtGeom.area(1).divide(1e6);
var overlapGapPct = dissolvedArea.subtract(tehsilAreaSum).divide(tehsilAreaSum).multiply(100).abs();
var maxFitError = ee.Number(tehsilStats.aggregate_max('fit_error_pct'));
var maxAreaDiff = ee.Number(tehsilBase.map(function (f) {
  return f.set('abs_diff', ee.Number(f.get('area_diff_pct')).abs());
}).aggregate_max('abs_diff'));
var modelUrbanPct = ee.Number(tehsilStats.aggregate_sum('pop_urban_model'))
  .divide(OFFICIAL.population).multiply(100);
var officialUrbanPct = OFFICIAL.urban / OFFICIAL.population * 100;
var adm2 = ee.FeatureCollection('WM/geoLab/geoBoundaries/600/ADM2')
  .filter(ee.Filter.eq('shapeGroup', 'PAK'))
  .filter(ee.Filter.eq('shapeName', 'Faisalabad'));

var controlList = [
  control('C01', 'Six tehsils present', tehsilGeoms.size(), TEHSIL_COUNT,
    ee.Algorithms.If(tehsilGeoms.size().eq(TEHSIL_COUNT), 'PASS', 'FAIL'),
    'If FAIL with tehsilAsset set, the asset names do not match tehsilCensus.'),
  control('C02', 'Tehsil census populations sum to district', censusSum, OFFICIAL.population,
    clientStatus(censusSum === OFFICIAL.population), 'Embedded values against the district total.'),
  control('C03', 'Urban plus rural equals district population', OFFICIAL.urban + OFFICIAL.rural,
    OFFICIAL.population, clientStatus(OFFICIAL.urban + OFFICIAL.rural === OFFICIAL.population),
    'Official district split.'),
  control('C04', 'Census tehsil areas sum to district area', areaSum, OFFICIAL.areaKm2,
    clientStatus(areaSum === OFFICIAL.areaKm2), 'Embedded values against the district total.'),
  control('C05', 'WorldPop image found for Pakistan and census year', wpCollection.size(), 1,
    ee.Algorithms.If(wpCollection.size().eq(1), 'PASS', 'FAIL'), 'Everything downstream needs this.'),
  control('C06', 'Tehsil polygons do not overlap or leave gaps (percent)', overlapGapPct, '0 to 0.5',
    ee.Algorithms.If(overlapGapPct.lte(0.5), 'PASS', 'REVIEW'),
    'Dissolved area against the sum of tehsil areas.'),
  control('C07', 'Fitted grid matches census per tehsil, worst case (percent)', maxFitError,
    'at most ' + CONFIG.constrainTolPct,
    ee.Algorithms.If(maxFitError.lte(CONFIG.constrainTolPct), 'PASS', 'FAIL'),
    'Small differences come from pixels split at tehsil edges.'),
  control('C08', 'Worst tehsil GIS area against census area (percent)', maxAreaDiff,
    'at most ' + CONFIG.areaReviewPct,
    ee.Algorithms.If(maxAreaDiff.lte(CONFIG.areaReviewPct), 'PASS', 'REVIEW'),
    'REVIEW is expected with the embedded polygons. Official boundaries would resolve it.'),
  control('C09', 'District GIS area (km2)', dissolvedArea, OFFICIAL.areaKm2, 'INFO',
    'Dissolved tehsils against the census area.'),
  control('C10', 'geoBoundaries ADM2 district area (km2)',
    ee.Algorithms.If(adm2.size().eq(1), adm2.geometry().area(100).divide(1e6), -1),
    OFFICIAL.areaKm2, 'INFO', 'Independent boundary source, for comparison only.'),
  control('C11', 'WorldPop district total before fitting', modelledTotal, OFFICIAL.population, 'INFO',
    'Shows how far the unfitted model is from the census.'),
  control('C12', 'Urban share, GHS-SMOD on fitted grid (percent)', modelUrbanPct, officialUrbanPct, 'INFO',
    'Morphological against the census administrative definition. They need not agree.')
];
if (ucStats) {
  controlList.push(control('C13', 'Union Councils inside district', ucStats.size(), 'your official count',
    'INFO', 'Compare with the official count for the delimitation you uploaded.'));
}
if (ucCensusMatched) {
  controlList.push(control('C14', 'UC polygons matched to a census row', ucCensusMatched, ucStats.size(),
    ee.Algorithms.If(ucCensusMatched.eq(ucStats.size()), 'PASS', 'FAIL'),
    'Unmatched UCs carry pop2023_census = -1.'));
}
var controls = ee.FeatureCollection(controlList);

print('CONTROL TABLE: read this first');
print(controls.map(function (f) {
  return ee.Feature(null, {
    row: ee.String(f.get('id')).cat(' ').cat(f.get('status')).cat(': ').cat(f.get('description'))
      .cat(' | observed ').cat(ee.Algorithms.String(f.get('observed')))
      .cat(' | expected ').cat(ee.Algorithms.String(f.get('expected')))
  });
}).aggregate_array('row'));

print('Tehsil statistics', tehsilStats.select([
  'tehsil', 'pop2023', 'census_area_km2', 'gis_area_km2', 'area_diff_pct', 'density_census',
  'density_gis', 'growth_pct_yr', 'pop_worldpop', 'fit_factor', 'urban_share_model_pct'
], null, false));
print('Metropolitan extent', metro);
print('Built-up settlement patches', settlements.size());

// ---------------------------------- MAP --------------------------------
var LIGHT_STYLE = [
  {stylers: [{saturation: -100}, {lightness: 35}]},
  {featureType: 'poi', stylers: [{visibility: 'off'}]},
  {featureType: 'transit', stylers: [{visibility: 'off'}]}
];
Map.setOptions('Atlas', {Atlas: LIGHT_STYLE});
Map.centerObject(districtGeom, 9);
Map.style().set('cursor', 'crosshair');

Map.addLayer(densityClassImage, {min: 0, max: 3, palette: PAL.tehsilDensity},
  'Tehsil density, census (people per km2)', false);
Map.addLayer(popDensity.add(1).log10().updateMask(popDensity.gt(0)),
  {min: 1, max: 4.5, palette: PAL.grid}, 'Population density, census-fitted grid');
Map.addLayer(urbanClass.clip(districtGeom),
  {min: 1, max: 4, palette: [PAL.urbanCentre, PAL.urbanCluster, PAL.rural, PAL.water]},
  'Urban/rural, GHS-SMOD ' + CONFIG.smodYear, false);
Map.addLayer(settlements.style({color: PAL.built, width: 1, fillColor: '00000055'}), {},
  'Built-up settlement patches', false);
Map.addLayer(settlementPointsRaw.style({color: PAL.built, pointSize: 2, width: 0, fillColor: PAL.built}), {},
  'Settlement centroids', false);
Map.addLayer(metro.style({color: PAL.metro, width: 3, fillColor: '00000000'}), {},
  'Metropolitan extent (urban centre)', false);
if (ucStats) {
  Map.addLayer(ucStats.style({color: PAL.uc, width: 1, fillColor: '00000000'}), {}, 'Union Councils');
}
if (namedSettlements) {
  Map.addLayer(namedSettlements.style({color: 'e31a1c', pointSize: 3, width: 1}), {}, 'Named settlements');
}
Map.addLayer(tehsilGeoms.style({color: '333333', width: 1.5, fillColor: '00000000'}), {}, 'Tehsil boundaries');
Map.addLayer(ee.FeatureCollection([ee.Feature(districtGeom)]).style({color: '000000', width: 3, fillColor: '00000000'}),
  {}, 'District boundary');

// --------------------------------- PANEL -------------------------------
// Remove any panel left by an earlier run, so that only one is ever shown.
ui.root.widgets().getJsArray().slice().forEach(function (widget) {
  if (widget instanceof ui.Panel) { ui.root.remove(widget); }
});
var panel = ui.Panel({style: {width: '380px', padding: '10px'}});
ui.root.insert(0, panel);

function heading(text) {
  return ui.Label(text, {fontWeight: 'bold', fontSize: '14px', margin: '12px 0 4px 0'});
}
function body(text) {
  return ui.Label(text, {fontSize: '12px', margin: '2px 0', color: '444444'});
}
function legendRow(color, label) {
  return ui.Panel([
    ui.Label('', {backgroundColor: '#' + color, padding: '8px', margin: '2px 6px 2px 0',
      border: '1px solid #999999'}),
    ui.Label(label, {fontSize: '12px', margin: '4px 0'})
  ], ui.Panel.Layout.flow('horizontal'));
}

panel.add(ui.Label('Faisalabad GIS Atlas', {fontWeight: 'bold', fontSize: '18px', margin: '0 0 2px 0'}));
panel.add(body('Component 01: Administrative GIS Mapping'));
panel.add(body('District population 2023: ' + OFFICIAL.population.toLocaleString() +
  ', six tehsils, ' + OFFICIAL.areaKm2.toLocaleString() + ' km2.'));

panel.add(heading('Click the map'));
var inspector = ui.Panel();
inspector.add(body('Click inside the district to read tehsil values.'));
panel.add(inspector);

panel.add(heading('Union Councils'));
panel.add(body(CONFIG.ucAsset
  ? 'Loaded from your asset. Population below is from the fitted grid unless a census table is joined.'
  : 'Not loaded. No official UC boundary exists in Earth Engine. Set ucAsset in CONFIG.'));

panel.add(heading('Tehsil density (people per km2, census area)'));
PAL.tehsilDensity.forEach(function (color, i) { panel.add(legendRow(color, DENSITY_LABELS[i])); });

panel.add(heading('Population density, census-fitted grid'));
panel.add(ui.Thumbnail({
  image: ee.Image.pixelLonLat().select(0),
  params: {bbox: [0, 0, 1, 0.1], dimensions: '320x14', format: 'png', min: 0, max: 1, palette: PAL.grid},
  style: {stretch: 'horizontal', margin: '2px 0', maxHeight: '18px'}
}));
panel.add(body('Log scale, left to right: 10, 100, 1,000, 10,000 and about 30,000 people per km2.'));

panel.add(heading('Urban/rural, modelled (GHS-SMOD)'));
panel.add(legendRow(PAL.urbanCentre, 'Urban centre'));
panel.add(legendRow(PAL.urbanCluster, 'Urban cluster'));
panel.add(legendRow(PAL.rural, 'Rural'));
panel.add(legendRow(PAL.water, 'Water'));

function barChart(title, props, axis, stacked, colors) {
  return ui.Chart.feature.byFeature(tehsilStats.sort('pop2023', false), 'tehsil', props)
    .setChartType('BarChart')
    .setOptions({
      title: title,
      hAxis: {title: axis, minValue: 0},
      vAxis: {textStyle: {fontSize: 11}},
      legend: {position: props.length > 1 ? 'bottom' : 'none'},
      isStacked: stacked,
      colors: colors,
      height: 260
    });
}

// PNG map images, prepared only on request because each one costs compute.
var whiteBackground = ee.Image.constant(1).visualize({min: 0, max: 1, palette: ['ffffff', 'ffffff']});
var tehsilLines = tehsilGeoms.style({color: '333333', width: 1.5, fillColor: '00000000'});
var districtLine = ee.FeatureCollection([ee.Feature(districtGeom)])
