/* Census values.
 * pop1998, pop2017, pop2023: citypopulation.de, Punjab admin page, source line
 *   "Pakistan Bureau of Statistics". The 2017 and 2023 columns sum exactly to the district totals.
 * census_area_km2: Wikipedia, Faisalabad District tehsil table, citing PBS.
 * Wikipedia gives different 2017 values for some tehsils (for example Faisalabad City 3,238,841
 * against 3,244,259 used here). Resolve this from the PBS table if 2017 growth will be published.
 * growth_pct_yr is calculated here from census dates 15 Mar 2017 and 1 Mar 2023. PBS publishes its
 * own growth rates, which may differ, so quote PBS rates where they exist.
 */
function tehsilCensus() {
  var years = 5.96;
  var rows = [
    {tehsil: 'Chak Jhumra', pop1998: 253806, pop2017: 332966, pop2023: 385169, census_area_km2: 654},
    {tehsil: 'Faisalabad City', pop1998: 2140346, pop2017: 3244259, pop2023: 3691999, census_area_km2: 168},
    {tehsil: 'Faisalabad Sadar', pop1998: 924110, pop2017: 1465027, pop2023: 1742958, census_area_km2: 1186},
    {tehsil: 'Jaranwala', pop1998: 1061846, pop2017: 1493923, pop2023: 1731148, census_area_km2: 1811},
    {tehsil: 'Samundri', pop1998: 508637, pop2017: 643114, pop2023: 729672, census_area_km2: 754},
    {tehsil: 'Tandlianwala', pop1998: 540802, pop2017: 703155, pop2023: 794873, census_area_km2: 1284}
  ];
  rows.forEach(function (r) {
    r.growth_pct_yr = (Math.pow(r.pop2023 / r.pop2017, 1 / years) - 1) * 100;
    r.source = 'PBS 2023 via secondary source, verify against PBS table';
  });
  return rows;
}

