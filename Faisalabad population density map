// Click inspector
function showValues(title, rows) {
  inspector.add(ui.Label(title, {fontWeight: 'bold', fontSize: '12px', margin: '4px 0 2px 0'}));
  rows.forEach(function (r) { inspector.add(body(r)); });
}
function fmt(value, digits) {
  if (value === null || value === undefined) { return 'n/a'; }
  return Number(value).toLocaleString(undefined, {maximumFractionDigits: digits});
}
var latestClick = 0;
Map.unlisten();
Map.onClick(function (coords) {
  var point = ee.Geometry.Point(coords.lon, coords.lat);
  latestClick += 1;
  var thisClick = latestClick;
  inspector.clear();
  inspector.add(body('Loading...'));
  tehsilStats.filterBounds(point).limit(1).evaluate(function (fc, error) {
    // A newer click replaces this one, so its late results are ignored.
    if (thisClick !== latestClick) { return; }
    inspector.clear();
    if (error) { inspector.add(body('Could not read values: ' + error)); return; }
    if (!fc.features.length) { inspector.add(body('Outside the district.')); return; }
    var t = fc.features[0].properties;
    showValues(t.tehsil + ' tehsil', [
      'Census population 2023: ' + fmt(t.pop2023, 0),
      'Census density: ' + fmt(t.density_census, 0) + ' per km2',
      'Growth 2017 to 2023: ' + fmt(t.growth_pct_yr, 2) + '% per year',
      'Urban share, modelled: ' + fmt(t.urban_share_model_pct, 1) + '%'
    ]);
    popDensity.reduceRegion({
      reducer: ee.Reducer.first(), geometry: point, crs: popProj, scale: popScale
    }).evaluate(function (values, densityError) {
      if (thisClick !== latestClick) { return; }
      if (densityError) {
        inspector.add(body('Fitted density could not be read: ' + densityError));
      } else if (values.pop_per_km2 === null || values.pop_per_km2 === undefined) {
        inspector.add(body('Fitted density here: no population modelled at this exact pixel.'));
      } else {
        inspector.add(body('Fitted density here: ' + fmt(values.pop_per_km2, 0) + ' per km2'));
      }
    });
    if (ucStats) {
      ucStats.filterBounds(point).limit(1).evaluate(function (ucFc) {
        if (thisClick !== latestClick || !ucFc || !ucFc.features.length) { return; }
        var u = ucFc.features[0].properties;
        showValues('Union Council: ' + u.uc_name, [
          'Code: ' + u.uc_code,
          'Area: ' + fmt(u.area_km2, 2) + ' km2',
          'Population, fitted grid: ' + fmt(u.pop_fit_total, 0),
          'Population, census: ' + (u.pop2023_census === undefined || u.pop2023_census < 0
            ? 'not supplied' : fmt(u.pop2023_census, 0))
        ]);
      });
    }
  });
});

